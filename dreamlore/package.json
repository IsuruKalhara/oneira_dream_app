{
  "name": "dreamlore",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Dreamlore (working name) \u2014 public-domain dream-interpretation knowledge base + /explain RAG API. Phase 0.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "download": "node scripts/download.mjs",
    "ingest": "node scripts/ingest.mjs",
    "add": "node scripts/add-source.mjs",
    "explain": "node scripts/explain-cli.mjs",
    "serve": "node src/server.mjs",
    "push": "node scripts/push-vectorize.mjs",
    "build:kb": "node scripts/build-worker-kb.mjs",
    "eval": "node eval/cli.mjs",
    "test": "node --test worker/test/*.test.mjs",
    "deploy": "npm run build:kb && cd worker && npx wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0"
  }
}
