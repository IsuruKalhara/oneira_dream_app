# ── OS ──
.DS_Store
Thumbs.db
*.log

# ── Secrets — NEVER commit real keys ──
**/.dev.vars
**/.env
**/.env.local
*.pem
*.key
**/service-account*.json

# ── Node (dreamlore backend + worker) ──
**/node_modules/
**/.wrangler/

# ── Generated / large data (regenerate: npm run download && npm run ingest) ──
dreamlore/data/raw/
dreamlore/data/index.json
dreamlore/data/vectorize.ndjson

# ── Flutter build artifacts (dreamlore_app/.gitignore has the full list) ──
**/.dart_tool/
**/build/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# ── Separate project, its own git repo — never commit into this one ──
timbre_voice_journal/

# ── Android release signing — NEVER commit ──
**/key.properties
**/*.jks
**/*.keystore
